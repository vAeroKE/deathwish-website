        --chakra-space-6: 1.5rem;
        --chakra-space-7: 1.75rem;
        --chakra-space-8: 2rem;
        --chakra-space-10: 2.5rem;
        --chakra-space-20: 5rem;
        --chakra-fonts-heading: 'Montserrat', sans-serif;
        --chakra-fonts-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        --chakra-fontWeights-bold: 700;
        --chakra-fontWeights-semibold: 600;
        --chakra-fontSizes-sm: 0.875rem;
        --chakra-fontSizes-md: 1rem;
        --chakra-fontSizes-lg: 1.125rem;
        --chakra-fontSizes-xl: 1.25rem;
        --chakra-fontSizes-3xl: 1.875rem;
        --chakra-fontSizes-4xl: 2.25rem;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--chakra-fonts-body);
        background: var(--chakra-colors-black);
        color: var(--chakra-colors-white);
        line-height: 1.5;
        min-height: 100vh;
      }

      a {
        color: mediumpurple;
        text-decoration: none;
        transition: all 0.15s;
      }

      a:hover {
        text-decoration: underline;
      }

      nav {
        position: fixed;
        top: 0;
        width: 100%;
        background: rgba(15, 15, 15, 0.8);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--chakra-colors-whiteAlpha-100);
        z-index: 100;
        padding: 1rem 2rem;
      }

      .nav-container {
        max-width: 1024px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-family: var(--chakra-fonts-heading);
        font-size: 1.5rem;
        font-weight: var(--chakra-fontWeights-bold);
        color: var(--chakra-colors-white);
        text-decoration: none;
      }

      .logo-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #805AD5, #EB459E);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
      }

      .nav-links {
        display: flex;
        gap: 2rem;
        list-style: none;
      }

      .nav-links a {
        color: var(--chakra-colors-whiteAlpha-600);
        text-decoration: none;
        font-weight: 500;
        font-size: var(--chakra-fontSizes-sm);
        transition: color 0.15s;
      }

      .nav-links a:hover {
        color: var(--chakra-colors-white);
      }

      .hero {
        padding: 10rem 2rem 6rem;
        text-align: center;
        background: linear-gradient(180deg, rgba(128, 90, 213, 0.1) 0%, var(--chakra-colors-black) 100%);
        position: relative;
        overflow: hidden;
      }

      .hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="none" stroke="rgba(128,90,213,0.1)" stroke-width="0.5"/></svg>') center/50px repeat;
        opacity: 0.5;
      }

      .hero-content {
        position: relative;
        z-index: 1;
        max-width: 800px;
        margin: 0 auto;
      }

      .hero h1 {
        font-family: var(--chakra-fonts-heading);
        font-size: var(--chakra-fontSizes-4xl);
        font-weight: var(--chakra-fontWeights-bold);
        margin-bottom: var(--chakra-space-4);
        background: linear-gradient(135deg, #805AD5, #EB459E);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.2;
      }

      .hero p {
        font-size: var(--chakra-fontSizes-lg);
        color: var(--chakra-colors-whiteAlpha-600);
        margin-bottom: var(--chakra-space-8);
        line-height: 1.625;
      }

      .btn-group {
        display: flex;
        gap: var(--chakra-space-4);
        justify-content: center;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: var(--chakra-space-2);
        padding: var(--chakra-space-3) var(--chakra-space-6);
        border-radius: var(--chakra-radii-md);
        font-weight: var(--chakra-fontWeights-semibold);
        text-decoration: none;
        transition: all 0.2s;
        border: none;
        cursor: pointer;
        font-size: var(--chakra-fontSizes-md);
      }

      .btn-primary {
        background: mediumpurple;
        color: var(--chakra-colors-black);
      }

      .btn-primary:hover {
        background: var(--chakra-colors-purple-300);
        transform: translateY(-2px);
        text-decoration: none;
      }

      .btn-secondary {
        background: transparent;
        color: mediumpurple;
        border: 1px solid mediumpurple;
      }

      .btn-secondary:hover {
        background: rgba(147, 112, 219, 0.12);
        text-decoration: none;
      }

      .btn-discord {
        background: #5865F2;
        color: white;
      }

      .btn-discord:hover {
        background: #4752C4;
        transform: translateY(-2px);
        text-decoration: none;
      }

      .container {
        max-width: 1024px;
        margin: 0 auto;
        padding: 0 var(--chakra-space-4);
      }

      .stats {
        padding: var(--chakra-space-20) var(--chakra-space-4);
        background: var(--chakra-colors-black);
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--chakra-space-6);
      }

      .stat-card {
        background: var(--chakra-colors-whiteAlpha-50);
        padding: var(--chakra-space-6);
        border-radius: var(--chakra-radii-lg);
        border: 1px solid var(--chakra-colors-whiteAlpha-100);
        text-align: center;
        backdrop-filter: blur(5px);
      }

      .stat-card h3 {
        color: var(--chakra-colors-whiteAlpha-600);
        font-size: var(--chakra-fontSizes-sm);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: var(--chakra-space-2);
      }

      .stat-value {
        font-family: var(--chakra-fonts-heading);
        font-size: var(--chakra-fontSizes-3xl);
        font-weight: var(--chakra-fontWeights-bold);
        color: mediumpurple;
      }

      .auth-section {
        padding: var(--chakra-space-20) var(--chakra-space-4);
        background: linear-gradient(180deg, var(--chakra-colors-black) 0%, rgba(128, 90, 213, 0.05) 100%);
      }

      .section-title {
        font-family: var(--chakra-fonts-heading);
        font-size: var(--chakra-fontSizes-3xl);
        font-weight: var(--chakra-fontWeights-bold);
        text-align: center;
        margin-bottom: var(--chakra-space-2);
      }

      .section-subtitle {
        color: var(--chakra-colors-whiteAlpha-600);
        text-align: center;
        margin-bottom: var(--chakra-space-10);
      }

      .auth-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: var(--chakra-space-8);
        margin-bottom: var(--chakra-space-20);
      }

      .auth-card {
        background: var(--chakra-colors-whiteAlpha-50);
        border: 1px solid var(--chakra-colors-whiteAlpha-100);
        border-radius: var(--chakra-radii-lg);
        padding: var(--chakra-space-8);
        text-align: center;
        backdrop-filter: blur(10px);
        position: relative;
        overflow: hidden;
      }

      .auth-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #805AD5, #EB459E);
      }

      .auth-card.nuke-card::before {
        background: linear-gradient(90deg, #EB459E, #FF0000);
      }

      .auth-icon {
        width: 64px;
        height: 64px;
        background: var(--chakra-colors-whiteAlpha-100);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto var(--chakra-space-5);
        font-size: 2rem;
      }

      .auth-card h3 {
        font-family: var(--chakra-fonts-heading);
        font-size: var(--chakra-fontSizes-xl);
        font-weight: var(--chakra-fontWeights-bold);
        margin-bottom: var(--chakra-space-3);
      }

      .auth-card p {
        color: var(--chakra-colors-whiteAlpha-600);
        font-size: var(--chakra-fontSizes-sm);
        margin-bottom: var(--chakra-space-6);
      }

      .placeholder-btn {
        display: inline-flex;
        align-items: center;
        gap: var(--chakra-space-2);
        padding: var(--chakra-space-3) var(--chakra-space-6);
        border-radius: var(--chakra-radii-md);
        font-weight: var(--chakra-fontWeights-semibold);
        font-size: var(--chakra-fontSizes-md);
        background: var(--chakra-colors-whiteAlpha-100);
        color: var(--chakra-colors-whiteAlpha-600);
        border: 2px dashed var(--chakra-colors-whiteAlpha-300);
        cursor: not-allowed;
        width: 100%;
        justify-content: center;
      }

      .commands {
        padding: var(--chakra-space-20) var(--chakra-space-4);
        background: var(--chakra-colors-black);
      }

      .bot-section {
        margin-bottom: var(--chakra-space-20);
      }

      .bot-header {
        display: flex;
        align-items: center;
        gap: var(--chakra-space-4);
        margin-bottom: var(--chakra-space-8);
        padding-bottom: var(--chakra-space-4);
        border-bottom: 1px solid var(--chakra-colors-whiteAlpha-100);
      }

      .bot-icon {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, #EB459E, #FF0000);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
      }

      .bot-icon.raid-icon {
        background: linear-gradient(135deg, #805AD5, #5865F2);
      }

      .bot-title {
        font-family: var(--chakra-fonts-heading);
        font-size: var(--chakra-fontSizes-xl);
        font-weight: var(--chakra-fontWeights-bold);
      }

      .bot-desc {
        color: var(--chakra-colors-whiteAlpha-600);
        font-size: var(--chakra-fontSizes-sm);
      }

      .command-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: var(--chakra-space-4);
      }

      .command-card {
        background: var(--chakra-colors-whiteAlpha-50);
        border: 1px solid var(--chakra-colors-whiteAlpha-100);
        border-radius: var(--chakra-radii-lg);
        padding: var(--chakra-space-5);
        transition: all 0.15s;
        backdrop-filter: blur(5px);
      }

      .command-card:hover {
        transform: translateY(-4px);
        border-color: mediumpurple;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
      }

      .command-header {
        display: flex;
        align-items: center;
        gap: var(--chakra-space-3);
        margin-bottom: var(--chakra-space-3);
      }

      .command-name {
        font-family: 'Courier New', monospace;
        background: var(--chakra-colors-whiteAlpha-100);
        padding: var(--chakra-space-1) var(--chakra-space-2);
        border-radius: 4px;
        font-size: var(--chakra-fontSizes-sm);
        font-weight: var(--chakra-fontWeights-bold);
        color: mediumpurple;
        white-space: nowrap;
      }

      .command-category {
        font-size: 0.75rem;
        color: var(--chakra-colors-whiteAlpha-600);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .command-desc {
        color: var(--chakra-colors-whiteAlpha-600);
        font-size: var(--chakra-fontSizes-sm);
        line-height: 1.625;
      }

      .command-args {
        display: flex;
        gap: var(--chakra-space-2);
        margin-top: var(--chakra-space-3);
        flex-wrap: wrap;
      }

      .arg {
        font-size: 0.75rem;
        padding: 0.125rem 0.375rem;
        background: var(--chakra-colors-whiteAlpha-100);
        border-radius: 4px;
        color: var(--chakra-colors-whiteAlpha-600);
      }

      .arg.required {
        color: #EB459E;
        background: rgba(235, 69, 158, 0.1);
      }

      .features {
        padding: var(--chakra-space-20) var(--chakra-space-4);
        background: linear-gradient(180deg, var(--chakra-colors-black) 0%, rgba(128, 90, 213, 0.05) 100%);
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: var(--chakra-space-6);
        margin-top: var(--chakra-space-10);
      }

      .feature-card {
        background: var(--chakra-colors-whiteAlpha-50);
        border: 1px solid var(--chakra-colors-whiteAlpha-100);
        border-radius: var(--chakra-radii-lg);
        padding: var(--chakra-space-7);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .feature-icon {
        width: 64px;
        height: 64px;
        background: var(--chakra-colors-whiteAlpha-100);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto var(--chakra-space-5);
        font-size: 2rem;
      }

      .feature-card h3 {
        font-family: var(--chakra-fonts-heading);
        font-size: var(--chakra-fontSizes-lg);
        font-weight: var(--chakra-fontWeights-bold);
        margin-bottom: var(--chakra-space-3);
      }

      .feature-card p {
        color: var(--chakra-colors-whiteAlpha-600);
        font-size: var(--chakra-fontSizes-sm);
      }

      footer {
        background: var(--chakra-colors-black);
        border-top: 1px solid var(--chakra-colors-whiteAlpha-100);
        padding: var(--chakra-space-8) var(--chakra-space-4);
        text-align: center;
      }

      footer p {
        color: var(--chakra-colors-whiteAlpha-600);
        font-size: var(--chakra-fontSizes-sm);
      }

      @media (max-width: 768px) {
        .hero h1 {
          font-size: var(--chakra-fontSizes-3xl);
        }
        
        .nav-links {
          display: none;
        }
        
        .command-grid {
          grid-template-columns: 1fr;
        }
        
        .btn-group {
          flex-direction: column;
          align-items: center;
        }

        .auth-grid {
          grid-template-columns: 1fr;
        }
      }

      ::-webkit-scrollbar {
        width: 8px;
      }

      ::-webkit-scrollbar-track {
        background: var(--chakra-colors-black);
      }

      ::-webkit-scrollbar-thumb {
        background: var(--chakra-colors-gray-700);
        border-radius: 4px;
      }

      ::-webkit-scrollbar-thumb:hover {
        background: var(--chakra-colors-gray-600);
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .stat-card, .command-card, .feature-card, .auth-card {
        animation: fadeIn 0.6s ease-out forwards;
      }
    </style>
  </head>
  <body>
    <nav>
      <div class="nav-container">
        <a href="#" class="logo">
          <div class="logo-icon">💀</div>
          <span>DeathWish</span>
        </a>
        <ul class="nav-links">
          <li><a href="#auth">Authorize</a></li>
          <li><a href="#commands">Commands</a></li>
          <li><a href="#features">Features</a></li>
          <li><a href="https://t.me/deathwishdc" target="_blank">Telegram</a></li>
          <li><a href="https://discord.gg/Qsdz9hW582" target="_blank">Discord</a></li>
        </ul>
      </div>
    </nav>

    <section class="hero">
      <div class="hero-content">
        <h1>DEATHWISH BOT</h1>
        <p>The ultimate Discord raiding and automation tool. Advanced spamming, packing, and server destruction features with a sleek button-based interface.</p>
        <div class="btn-group">
          <a href="https://t.me/deathwishdc" class="btn btn-secondary" target="_blank">
            <span>✈️</span> Join Telegram
          </a>
          <a href="https://discord.gg/Qsdz9hW582" class="btn btn-discord" target="_blank">
            <span>💬</span> Join Discord
          </a>
        </div>
      </div>
    </section>

    <section class="stats" id="stats">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-card">
            <h3>Raid Commands</h3>
            <div class="stat-value">11</div>
          </div>
          <div class="stat-card">
            <h3>Nuke Commands</h3>
            <div class="stat-value">40+</div>
          </div>
          <div class="stat-card">
            <h3>Shard Count</h3>
            <div class="stat-value">Auto</div>
          </div>
          <div class="stat-card">
            <h3>Success Rate</h3>
            <div class="stat-value">99%</div>
          </div>
        </div>
      </div>
    </section>

    <section class="auth-section" id="auth">
      <div class="container">
        <h2 class="section-title">Authorization</h2>
        <p class="section-subtitle">Connect your server to unlock advanced features</p>
        
        <div class="auth-grid">
          <div class="auth-card nuke-card">
            <div class="auth-icon">☢️</div>
            <h3>DeathWish Nuke</h3>
            <p>Full server destruction capabilities including mass deletion, creation, and advanced spamming features.</p>
            <div class="placeholder-btn">
              <span>🔒</span> Authorize Nuke Bot (Coming Soon)
            </div>
          </div>

          <div class="auth-card">
            <div class="auth-icon">⚔️</div>
            <h3>DeathWish Raid</h3>
            <p>Advanced raiding tools with button controls, packing, spamming, and targeting features.</p>
            <div class="placeholder-btn">
              <span>🔒</span> Authorize Raid Bot (Coming Soon)
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="commands" id="commands">
      <div class="container">
        <h2 class="section-title">Command Reference</h2>
        <p class="section-subtitle">Complete list of available raid and nuke commands</p>

        <!-- Raid Bot Commands (from help command) -->
        <div class="bot-section">
          <div class="bot-header">
            <div class="bot-icon raid-icon">⚔️</div>
            <div>
              <h3 class="bot-title">DeathWish Raid</h3>
              <p class="bot-desc">Button-controlled raiding and targeting commands</p>
            </div>
          </div>
          
          <div class="command-grid">
            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/say</span>
                <span class="command-category">Raiding</span>
              </div>
              <p class="command-desc">Send a message</p>
              <div class="command-args">
                <span class="arg required">&lt;message&gt;</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/spam</span>
                <span class="command-category">Raiding</span>
              </div>
              <p class="command-desc">Spam messages</p>
              <div class="command-args">
                <span class="arg required">&lt;message&gt;</span>
                <span class="arg required">&lt;times&gt;</span>
                <span class="arg">[delay]</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/raid</span>
                <span class="command-category">Raiding</span>
              </div>
              <p class="command-desc">Execute raid (1 or 2)</p>
              <div class="command-args">
                <span class="arg required">&lt;type&gt;</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/emojispam</span>
                <span class="command-category">Raiding</span>
              </div>
              <p class="command-desc">Spam emojis</p>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/blankspam</span>
                <span class="command-category">Raiding</span>
              </div>
              <p class="command-desc">Spams blank messages</p>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/pollspam</span>
                <span class="command-category">Raiding</span>
              </div>
              <p class="command-desc">Spams polls</p>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/blame</span>
                <span class="command-category">Raiding</span>
              </div>
              <p class="command-desc">Blame someone for raiding</p>
              <div class="command-args">
                <span class="arg required">&lt;user&gt;</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/ad</span>
                <span class="command-category">Raiding</span>
              </div>
              <p class="command-desc">Send advertisement</p>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/pack</span>
                <span class="command-category">Targeting</span>
              </div>
              <p class="command-desc">Pack a user</p>
              <div class="command-args">
                <span class="arg required">&lt;user&gt;</span>
                <span class="arg">[delay]</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/rape</span>
                <span class="command-category">Targeting</span>
              </div>
              <p class="command-desc">Rape a user</p>
              <div class="command-args">
                <span class="arg required">&lt;user&gt;</span>
                <span class="arg">[delay]</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/tokenlog</span>
                <span class="command-category">Targeting</span>
              </div>
              <p class="command-desc">Generate a token log</p>
              <div class="command-args">
                <span class="arg required">&lt;user&gt;</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Nuke Bot Commands -->
        <div class="bot-section">
          <div class="bot-header">
            <div class="bot-icon">☢️</div>
            <div>
              <h3 class="bot-title">DeathWish Nuke</h3>
              <p class="bot-desc">Server destruction and mass action commands (DeathWish members only)</p>
            </div>
          </div>

          <div class="command-grid">
            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/nuke</span>
                <span class="command-category">Destruction</span>
              </div>
              <p class="command-desc">Full server nuke - deletes channels, creates new ones, renames server, and spams.</p>
              <div class="command-args">
                <span class="arg">[server_name]</span>
                <span class="arg">[channel_name]</span>
                <span class="arg">[channel_count]</span>
                <span class="arg">[spam_message]</span>
                <span class="arg">[icon_url]</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/dac</span>
                <span class="command-category">Destruction</span>
              </div>
              <p class="command-desc">Delete all channels in the server rapidly.</p>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/ctc</span>
                <span class="command-category">Creation</span>
              </div>
              <p class="command-desc">Create text channels in bulk (up to 200).</p>
              <div class="command-args">
                <span class="arg">[channel_name]</span>
                <span class="arg">[amount]</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/rs</span>
                <span class="command-category">Creation</span>
              </div>
              <p class="command-desc">Create roles in bulk (up to 250).</p>
              <div class="command-args">
                <span class="arg">[role_name]</span>
                <span class="arg">[amount]</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/rac</span>
                <span class="command-category">Renaming</span>
              </div>
              <p class="command-desc">Rename all channels to specified name.</p>
              <div class="command-args">
                <span class="arg">[new_name]</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/rnr</span>
                <span class="command-category">Renaming</span>
              </div>
              <p class="command-desc">Rename all roles to specified name.</p>
              <div class="command-args">
                <span class="arg">[new_name]</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/gn</span>
                <span class="command-category">Server</span>
              </div>
              <p class="command-desc">Change server name.</p>
              <div class="command-args">
                <span class="arg">[new_name]</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/bana</span>
                <span class="command-category">Mass Action</span>
              </div>
              <p class="command-desc">Ban all members (free for servers ≤100 members, premium for larger).</p>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/kall</span>
                <span class="command-category">Mass Action</span>
              </div>
              <p class="command-desc">Kick all members (free for servers ≤100 members).</p>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/massnick</span>
                <span class="command-category">Mass Action</span>
              </div>
              <p class="command-desc">Change nickname of all members.</p>
              <div class="command-args">
                <span class="arg">[nickname]</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/unbanall</span>
                <span class="command-category">Mass Action</span>
              </div>
              <p class="command-desc">Unban all banned users from the server.</p>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/delemoji</span>
                <span class="command-category">Deletion</span>
              </div>
              <p class="command-desc">Delete all custom emojis from the server.</p>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/delinvites</span>
                <span class="command-category">Deletion</span>
              </div>
              <p class="command-desc">Delete all invite links from the server.</p>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/delstickers</span>
                <span class="command-category">Deletion</span>
              </div>
              <p class="command-desc">Delete all stickers from the server.</p>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/delwebhooks</span>
                <span class="command-category">Deletion</span>
              </div>
              <p class="command-desc">Delete all webhooks from all channels.</p>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/spem</span>
                <span class="command-category">Premium</span>
              </div>
              <p class="command-desc">Premium embed nuke with custom title, description, image, and button.</p>
              <div class="command-args">
                <span class="arg required">&lt;title&gt;</span>
                <span class="arg required">&lt;description&gt;</span>
                <span class="arg required">&lt;spam_message&gt;</span>
                <span class="arg required">&lt;channel_name&gt;</span>
                <span class="arg">[num_channels]</span>
                <span class="arg">[image_url]</span>
                <span class="arg">[button_url]</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/nsfwspam</span>
                <span class="command-category">Premium</span>
              </div>
              <p class="command-desc">Spam NSFW images from nekobot API.</p>
              <div class="command-args">
                <span class="arg required">&lt;category&gt;</span>
                <span class="arg">[channel_name]</span>
                <span class="arg">[channel_count]</span>
                <span class="arg">[duration]</span>
                <span class="arg">[wipe]</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/redditspam</span>
                <span class="command-category">Premium</span>
              </div>
              <p class="command-desc">Spam images from specified subreddit.</p>
              <div class="command-args">
                <span class="arg required">&lt;subreddit&gt;</span>
                <span class="arg">[channel_name]</span>
                <span class="arg">[channel_count]</span>
                <span class="arg">[duration]</span>
                <span class="arg">[wipe]</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/adminflood</span>
                <span class="command-category">Premium</span>
              </div>
              <p class="command-desc">Create multiple admin roles.</p>
              <div class="command-args">
                <span class="arg">[amount]</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/corrupt</span>
                <span class="command-category">Server</span>
              </div>
              <p class="command-desc">Corrupt server settings - max verification, explicit filter, all notifications.</p>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/grantadmin</span>
                <span class="command-category">Server</span>
              </div>
              <p class="command-desc">Grant administrator role to specified user.</p>
              <div class="command-args">
                <span class="arg required">&lt;user&gt;</span>
              </div>
            </div>

            <div class="command-card">
              <div class="command-header">
                <span class="command-name">/give</span>
                <span class="command-category">Server</span>
              </div>
              <p class="command-desc">Grant all permissions to @everyone role.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="features" id="features">
      <div class="container">
        <h2 class="section-title">Features</h2>
        <p class="section-subtitle">Why choose DeathWish?</p>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">⚡</div>
            <h3>Auto Sharding</h3>
            <p>Automatic shard management for maximum uptime and performance across thousands of servers.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">🎨</div>
            <h3>Canvas Generation</h3>
            <p>Beautiful nuke leaderboards and statistics generated with PIL/Pillow.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">🔒</div>
            <h3>Authorization System</h3>
            <p>DeathWish member-only commands with automatic guild membership checking.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">⏱️</div>
            <h3>Rate Limiting</h3>
            <p>Intelligent rate limit handling with cooldowns to prevent bot bans.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">📝</div>
            <h3>Premium Tiers</h3>
            <p>Free and premium command tiers with mass action limits and custom parameters.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">☢️</div>
            <h3>Dual Bot System</h3>
            <p>Separate raid and nuke bots for different use cases and permission levels.</p>
          </div>
        </div>
      </div>
    </section>

    <footer>
      <p>DeathWish Bot &copy; 2025 | Not affiliated with Discord | <a href="https://t.me/deathwishdc">Telegram</a> | <a href="https://discord.gg/Qsdz9hW582">Discord</a> | Use at your own risk</p>
    </footer>

    <script>
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
    </script>
  </body>
</html>
